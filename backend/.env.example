# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# IMPORTANT: Never commit your real API key to git. Place your real key in backend/.env
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini Model (e.g., gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: API base URL override (leave empty to use default Google endpoint)
GEMINI_API_BASE_URL=

# Backend Server Configuration
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
